# ThesisLab Agent MVP. Copy to .env; never commit .env.
# Direct Python: process environment takes precedence; no shell interpolation.
# Compose env_file may interpolate $, so quote literal credentials as documented.
# Model names below are examples; use a model available to your account that
# supports Chat Completions and JSON object output.
THESISLAB_LLM_PROVIDER=deepseek
THESISLAB_LLM_MODEL=deepseek-chat
THESISLAB_LLM_API_KEY=
# Alternative: openai + gpt-4.1-mini; qwen + qwen-plus.

# Supported financial provider: fuyao or none. Requires your own authorized key.
THESISLAB_FINANCIAL_PROVIDER=fuyao
THESISLAB_FINANCIAL_API_KEY=

# Capability gate, NOT user consent. Authorize retrieval separately in Web UI.
THESISLAB_ALLOW_PUBLIC_DISCLOSURES=true
# Required for SEC fair access, never returned by API.
THESISLAB_SEC_CONTACT=

# Legacy M1/M2 regression configuration, not a live-data fallback.
THESISLAB_PHASE3_ROOT=
# Legacy M2.5 CLI only; Agent MVP uses THESISLAB_LLM_API_KEY above.
DEEPSEEK_API_KEY=
